# MeshAPI gateway (https://developers.meshapi.ai) — dashboard > API Keys
MESH_API_KEY=rsk_your_meshapi_key_here
MESHAPI_BASE_URL=https://api.meshapi.ai
# provider/model string routed through MeshAPI, e.g. openai/gpt-4o-mini or mistral/mistral-large-3-675b-instruct
MESHAPI_CHAT_MODEL=openai/gpt-4o-mini

# Jina AI embeddings (https://jina.ai) — API key
JINA_API_KEY=jina_your_key_here
JINA_MODEL=jina-embeddings-v3
JINA_DIMENSIONS=1024

# Pinecone vector database (https://www.pinecone.io) — API key
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_INDEX_NAME=meshapi-demo-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# RAG
RAG_TOP_K=3
